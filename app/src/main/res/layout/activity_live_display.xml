<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tatami_purple">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">


        <!-- =====================================================
             MAIN CONTENT CARD
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="#CC0D1022">


            <!-- =====================================================
                 TOP TITLE SECTION
                 Bigger section
            ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺"
                    android:textSize="46sp"
                    android:gravity="center" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="LIVE DISPLAY"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:gravity="center" />


            </LinearLayout>


            <!-- =====================================================
                 DESCRIPTION SECTION
            ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:gravity="center">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Open or share the tournament big-screen scoreboard"
                    android:textColor="#D7D7DF"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />


            </LinearLayout>


            <!-- =====================================================
                 URL SECTION
            ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.15"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE SCOREBOARD URL"
                    android:textColor="#BDBDC8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />


                <TextView
                    android:id="@+id/txtLiveUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#33000000"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="https://your-project.web.app"
                    android:textColor="#D58CFF"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:maxLines="2" />


            </LinearLayout>


            <!-- =====================================================
                 BUTTON SECTION
            ====================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2.6"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">


                <!-- OPEN BUTTON -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <Button
                        android:id="@+id/btnOpenLiveDisplay"
                        style="@style/KumiteButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="OPEN LIVE DISPLAY"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- SHARE BUTTON -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <Button
                        android:id="@+id/btnShareLiveDisplay"
                        style="@style/KumiteButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="SHARE DISPLAY LINK"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- COPY BUTTON -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <Button
                        android:id="@+id/btnCopyLiveDisplay"
                        style="@style/KumiteButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="COPY LINK"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>


            </LinearLayout>


        </LinearLayout>


    </LinearLayout>


</FrameLayout>