<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/myapplogin"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">


    <!-- =====================================================
         TOP AREA
         Keeps logo/top background visible
    ====================================================== -->

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15" />


    <!-- =====================================================
         CENTER CARD
    ====================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="20dp"
        android:background="@drawable/welcome_quote_card_bg">


        <!-- =================================================
             TITLE AREA
        ================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:gravity="center_vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Champions"
                android:textColor="#C03DFF"
                android:textSize="27sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Begin"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />


            <!-- Small purple line -->

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="9dp"
                android:background="#C03DFF" />


        </LinearLayout>


        <!-- =================================================
             FEATURE AREA
        ================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">


            <!-- TRAIN HARDER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="◎"
                    android:textColor="#CE45FF"
                    android:textSize="21sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Train harder."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />


            </LinearLayout>


            <!-- FIGHT SMARTER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="♜"
                    android:textColor="#CE45FF"
                    android:textSize="19sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Fight smarter."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />


            </LinearLayout>


            <!-- REACH FUTURE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">


                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="▥"
                    android:textColor="#CE45FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Reach future."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />


            </LinearLayout>


        </LinearLayout>


        <!-- =================================================
             SMALL MOTIVATION TEXT
        ================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="TRAIN  •  COMPETE  •  IMPROVE"
            android:textColor="#C5B8D0"
            android:textSize="9sp"
            android:letterSpacing="0.08" />


        <!-- =================================================
             START FREE BUTTON
        ================================================== -->

        <Button
            android:id="@+id/btnStartfree"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#7920B8"
            android:text="START FREE   ➜"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />


    </LinearLayout>


    <!-- =====================================================
         BOTTOM AREA
         Keeps bottom slogan/background visible
    ====================================================== -->

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75" />


</LinearLayout>