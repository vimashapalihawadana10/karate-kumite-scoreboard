<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="22dp"
    android:background="@drawable/tatami_purple">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:gravity="center"
        android:text="Scoreboard Settings"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.6"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC0D1022"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical"
                android:text="Countdown"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="02:00"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnTimeUp"
                    android:layout_width="36dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/arrow_up_float"
                    android:background="@android:color/transparent"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnTimeDown"
                    android:layout_width="36dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/arrow_down_float"
                    android:background="@android:color/transparent"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside" />
            </LinearLayout>

        </LinearLayout>

        <!-- Gap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical"
                android:text="Winning Gap"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtGap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55"
                android:gravity="center"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnGapUp"
                    android:layout_width="36dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/arrow_up_float"
                    android:background="@android:color/transparent"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnGapDown"
                    android:layout_width="36dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@android:drawable/arrow_down_float"
                    android:background="@android:color/transparent"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:gravity="center"
                android:text="points"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6A1B9A"/>

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3" />

</LinearLayout>