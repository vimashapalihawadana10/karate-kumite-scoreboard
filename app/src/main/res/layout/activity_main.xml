<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tatami">


    <!-- Main full screen container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">


        <!-- =====================================================
             TOP HEADER
             weight = 1.2
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- Logo side -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">







                <!-- App title -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIGHTZONE"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.12"
                        android:text="TRAIN  •  TRACK  •  IMPROVE"
                        android:textColor="#B8B8C8"
                        android:textSize="7sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- Profile -->



        </LinearLayout>


        <!-- =====================================================
             QUOTE SECTION
             weight = 1.25
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/quote_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">


            <!-- Quote symbol -->

            <TextView
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:paddingTop="5dp"
                android:text="“"
                android:textColor="#C34BFF"
                android:textSize="36sp"
                android:textStyle="bold" />


            <!-- Quote -->

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Discipline today.\nleads to success tomorrow."
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="italic" />


            <!-- Author -->



        </LinearLayout>



        <!-- =====================================================
             MENU SECTION
             Largest section
             weight = 6.3
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6.3"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">


            <!-- ===============================================
                 NEW FIGHT
            ================================================ -->

            <LinearLayout
                android:id="@+id/cardNewFight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/menu_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="horizontal">


                <!-- Icon section -->

                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/menu_icon_panel">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🥋"
                        android:textSize="27dp" />

                </FrameLayout>


                <!-- Text -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="17dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEW FIGHT"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Start a new match"
                        android:textColor="#CFCFD8"
                        android:textSize="10sp" />

                </LinearLayout>


                <!-- Arrow -->

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#D83DFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

            </LinearLayout>



            <!-- ===============================================
                 FIGHT HISTORY
            ================================================ -->

            <LinearLayout
                android:id="@+id/cardHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/menu_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="horizontal">


                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/menu_icon_panel">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📋"
                        android:textSize="27sp" />

                </FrameLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="17dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIGHT HISTORY"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="View past matches"
                        android:textColor="#CFCFD8"
                        android:textSize="10sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#D83DFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

            </LinearLayout>



            <!-- ===============================================
                 LIVE DISPLAY
            ================================================ -->

            <LinearLayout
                android:id="@+id/cardLiveDisplay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/menu_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="horizontal">


                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/menu_icon_panel">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📺"
                        android:textSize="27sp" />

                </FrameLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="17dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE DISPLAY"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Open or share big screen scoreboard"
                        android:textColor="#CFCFD8"
                        android:textSize="9sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#D83DFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

            </LinearLayout>



            <!-- ===============================================
                 SETTINGS
            ================================================ -->

            <LinearLayout
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/menu_card_outline"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="horizontal">


                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/menu_icon_panel">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⚙"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp" />

                </FrameLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="17dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SETTINGS"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Manage preferences"
                        android:textColor="#CFCFD8"
                        android:textSize="10sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#D83DFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>



        <!-- =====================================================
             BOTTOM MOTIVATION
             weight = 1.15
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15"
            android:layout_marginTop="9dp"
            android:background="@drawable/bottom_quote_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">


            <!-- Trophy -->




            <!-- Divider -->

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                android:background="#886F58C8" />


            <!-- Motivation -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KEEP GOING"
                    android:textColor="#C9C8D6"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Champions are built every day."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>




        </LinearLayout>

    </LinearLayout>

</FrameLayout>