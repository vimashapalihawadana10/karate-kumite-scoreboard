<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/tatami_purple">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">


        <!-- =========================================
             TOP HEADER
        ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Logo / App Name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="🥋"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIGHTZONE"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRAIN  •  TRACK  •  IMPROVE"
                        android:textColor="#B8B8C8"
                        android:textSize="7sp"
                        android:letterSpacing="0.15" />

                </LinearLayout>

            </LinearLayout>




        </LinearLayout>


        <!-- =========================================
             QUOTE CARD
        ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/quote_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:paddingTop="8dp"
                android:text="“"
                android:textColor="#B84CFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Discipline today.\nleads to success tomorrow."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— Unknown"
                android:textColor="#D4D4DE"
                android:textSize="9sp" />

        </LinearLayout>


        <!-- =========================================
             NEW FIGHT
        ========================================== -->

        <LinearLayout
            android:id="@+id/cardNewFight"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/menu_card_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal">

            <!-- Icon Area -->
            <FrameLayout
                android:layout_width="95dp"
                android:layout_height="match_parent"
                android:background="@drawable/menu_icon_panel">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🥋"
                    android:textSize="38sp" />

            </FrameLayout>


            <!-- Text -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEW FIGHT"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Start a new match"
                    android:textColor="#CCCCD8"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- Arrow -->
            <TextView
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="›"
                android:textColor="#D83DFF"
                android:textSize="48sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- =========================================
             FIGHT HISTORY
        ========================================== -->

        <LinearLayout
            android:id="@+id/cardHistory"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/menu_card_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="95dp"
                android:layout_height="match_parent"
                android:background="@drawable/menu_icon_panel">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📋"
                    android:textSize="38sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIGHT HISTORY"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="View past matches"
                    android:textColor="#CCCCD8"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="›"
                android:textColor="#D83DFF"
                android:textSize="48sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- =========================================
             LIVE DISPLAY
        ========================================== -->

        <LinearLayout
            android:id="@+id/cardLiveDisplay"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/menu_card_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="95dp"
                android:layout_height="match_parent"
                android:background="@drawable/menu_icon_panel">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📺"
                    android:textSize="38sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE DISPLAY"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Open or share big screen scoreboard"
                    android:textColor="#CCCCD8"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="›"
                android:textColor="#D83DFF"
                android:textSize="48sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- =========================================
             SETTINGS
        ========================================== -->

        <LinearLayout
            android:id="@+id/cardSettings"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/menu_card_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="95dp"
                android:layout_height="match_parent"
                android:background="@drawable/menu_icon_panel">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Manage preferences"
                    android:textColor="#CCCCD8"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="›"
                android:textColor="#D83DFF"
                android:textSize="48sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- =========================================
             BOTTOM MOTIVATION CARD
        ========================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bottom_quote_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🏆"
                android:textSize="30sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:background="#886F58C8"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KEEP GOING"
                    android:textColor="#C9C8D6"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Champions are built\nevery day."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>



        </LinearLayout>

    </LinearLayout>

</ScrollView>